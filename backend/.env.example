# Copy to backend/.env and replace every placeholder locally.
# Never commit backend/.env or put server keys in frontend/.env.

APP_NAME=SalesIA Enterprise
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false

API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Needed by server-side account administration. Keep it only in backend/.env.
SUPABASE_SECRET_KEY=

# Generate a unique value locally, for example with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:5173
