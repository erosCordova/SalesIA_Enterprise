backend/.venv/
backend/venv/
backend/env/

__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.coverage
coverage.xml
htmlcov/

.mypy_cache/
.ruff_cache/

*.egg-info/
dist/
build/


# ---------------------------------------------------------
# VARIABLES DE ENTORNO / SECRETOS
# ---------------------------------------------------------

.env
.env.*
!.env.example

backend/.env
frontend/.env

backend/.env.local
frontend/.env.local

*.pem
*.key


# ---------------------------------------------------------
# FRONTEND - Node / React / Vite
# ---------------------------------------------------------

frontend/node_modules/
node_modules/

frontend/dist/
frontend/build/

.vite/
frontend/.vite/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

*.tsbuildinfo


# ---------------------------------------------------------
# EDITORES / IDE
# ---------------------------------------------------------

.vscode/
.idea/

*.code-workspace

*.swp
*.swo


# ---------------------------------------------------------
# WINDOWS
# ---------------------------------------------------------

Thumbs.db
ehthumbs.db
Desktop.ini


# ---------------------------------------------------------
# MACOS
# ---------------------------------------------------------

.DS_Store


